# Optional: connect to the real Supabase backend Lovable already set up.
# Get these from your Lovable project's Supabase integration (or supabase.com dashboard
# -> Project Settings -> API). Without these, the site runs on local demo data instead
# (stored in the browser only, fine for a demo, not shared between visitors).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Simple password gate for the owner admin area (this is a lightweight stand-in for
# real auth — good enough for a demo, replace with proper auth before real launch).
ADMIN_PASSWORD=change-me-before-launch
